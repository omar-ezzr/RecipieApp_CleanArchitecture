# Local development example. Copy to API/.env or use .NET user-secrets.
# API/.env is loaded only in Development.

ConnectionStrings__DefaultConnection=

Jwt__Key=
Jwt__Issuer=Recepie.Api
Jwt__Audience=Recepie.Web
Jwt__AccessTokenMinutes=5
Jwt__RefreshTokenDays=7

Cors__AllowedOrigins__0=http://localhost:4203
Database__AutoMigrate=false

RecipeMedia__StoragePath=
RecipeMedia__PublicPath=/images/recipes

AdminSeed__Email=
AdminSeed__DisplayName=
AdminSeed__Password=

# Optional trusted local reverse proxy IPs.
# ReverseProxy__KnownProxies__0=127.0.0.1
